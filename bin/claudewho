#!/bin/bash
set -euo pipefail

VERSION="2.5.0"
CONFIG_FILE="${CLAUDEWHO_CONFIG:-$HOME/.claudewho.conf}"
CONFIG_DIR_PREFIX="$HOME/.claudewho-"
WRAPPER_DIR="$HOME/.local/bin"
CURRENT_ACCOUNT_FILE="$HOME/.claudewho-current-account"
KEYCHAIN_MAP_FILE="$HOME/.claudewho-keychain.map"

# Colors (disabled if not a terminal)
if [[ -t 1 ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BLUE='\033[0;34m'
    MAGENTA='\033[0;35m'
    CYAN='\033[0;36m'
    BOLD='\033[1m'
    DIM='\033[2m'
    NC='\033[0m'
    # Claude orange #C15F3C
    ORANGE='\033[38;2;193;95;60m'
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    MAGENTA=''
    CYAN=''
    BOLD=''
    DIM=''
    NC=''
    ORANGE=''
fi

# Ensure config file exists
touch_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        touch "$CONFIG_FILE"
    fi
}

# Get all registered accounts
get_accounts() {
    touch_config
    cat "$CONFIG_FILE" 2>/dev/null | grep -v '^$' | sort -u || true
}

# Check if account exists in config
account_exists() {
    local name="$1"
    get_accounts | grep -qx "$name"
}

# Validate account name
validate_name() {
    local name="$1"
    if [[ ! "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
        echo -e "${RED}Error:${NC} Invalid account name '$name'"
        echo "Names must be lowercase, start with a letter/number, and contain only letters, numbers, and hyphens."
        exit 1
    fi
    if [[ ${#name} -gt 50 ]]; then
        echo -e "${RED}Error:${NC} Account name too long (max 50 characters)"
        exit 1
    fi
}

# Check if ~/.local/bin is in PATH
check_path() {
    if [[ ":$PATH:" != *":$WRAPPER_DIR:"* ]]; then
        return 1
    fi
    return 0
}

# Create wrapper script for an account
create_wrapper() {
    local name="$1"
    local dir="${CONFIG_DIR_PREFIX}${name}"
    local wrapper_path="${WRAPPER_DIR}/claudewho-${name}"

    # Ensure wrapper directory exists
    mkdir -p "$WRAPPER_DIR"

    # Create the wrapper script
    cat > "$wrapper_path" << EOF
#!/bin/bash
export CLAUDE_CONFIG_DIR="$dir"
exec claude "\$@"
EOF

    chmod +x "$wrapper_path"
}

# Remove wrapper script for an account
remove_wrapper() {
    local name="$1"
    local wrapper_path="${WRAPPER_DIR}/claudewho-${name}"

    if [[ -f "$wrapper_path" ]]; then
        rm -f "$wrapper_path"
    fi
}

# Create IDE wrapper that follows current account (dynamic)
create_ide_wrapper() {
    local wrapper_path="${WRAPPER_DIR}/claudewho-ide"

    mkdir -p "$WRAPPER_DIR"

    cat > "$wrapper_path" << 'WRAPPER_EOF'
#!/bin/bash
# Claude IDE wrapper - managed by claudewho
# Used as claude-code.claudeProcessWrapper in VSCode
# Follows the current account set by: claudewho use <name>

CURRENT_ACCOUNT_FILE="$HOME/.claudewho-current-account"
CONFIG_DIR_PREFIX="$HOME/.claudewho-"

# Only follow the current-account file if a parent hasn't already set
# CLAUDE_CONFIG_DIR (e.g. via `claudewho-<name>`). Otherwise we'd stomp
# the explicit per-account choice.
if [[ -z "${CLAUDE_CONFIG_DIR:-}" && -f "$CURRENT_ACCOUNT_FILE" ]]; then
    account=$(cat "$CURRENT_ACCOUNT_FILE" 2>/dev/null)
    if [[ -n "$account" ]]; then
        export CLAUDE_CONFIG_DIR="${CONFIG_DIR_PREFIX}${account}"
    fi
fi

exec "$@"
WRAPPER_EOF

    chmod +x "$wrapper_path"
}

# Create IDE wrapper for a specific account (static)
create_ide_account_wrapper() {
    local name="$1"
    local dir="${CONFIG_DIR_PREFIX}${name}"
    local wrapper_path="${WRAPPER_DIR}/claudewho-ide-${name}"

    mkdir -p "$WRAPPER_DIR"

    cat > "$wrapper_path" << EOF
#!/bin/bash
# Claude IDE wrapper for account '$name' - managed by claudewho
# Used as claude-code.claudeProcessWrapper in VSCode
export CLAUDE_CONFIG_DIR="$dir"
exec "\$@"
EOF

    chmod +x "$wrapper_path"
}

# Remove IDE wrapper for an account
remove_ide_account_wrapper() {
    local name="$1"
    local wrapper_path="${WRAPPER_DIR}/claudewho-ide-${name}"

    if [[ -f "$wrapper_path" ]]; then
        rm -f "$wrapper_path"
    fi
}

# Get current account name
get_current_account() {
    if [[ -f "$CURRENT_ACCOUNT_FILE" ]]; then
        cat "$CURRENT_ACCOUNT_FILE" 2>/dev/null || true
    fi
}

# ----- Keychain integration (macOS, IDE / Desktop Claude Code) -------------
# The Claude **CLI** (v2.1.x) stores credentials per account under
# `Claude Code-credentials-<8hex>` and disambiguates them by the active
# profile's `.claude.json` accountUuid. CLI multi-account therefore works
# natively, once each profile has been logged in once — claudewho's only
# job for the CLI is to set CLAUDE_CONFIG_DIR via the wrappers.
#
# The suffix-less `Claude Code-credentials` entry is used by the Claude
# **Desktop app / IDE extension** (e.g. the VSCode "claude-code" extension).
# That side has no native multi-account support, so claudewho swaps
# per-profile stashes (service: `Claude Code-credentials-<name>`) into the
# canonical slot on `claudewho use <name>`. Tokens never leave the Keychain.
#
# Verified empirically; see diagnostics/keychain-experiment/.

KEYCHAIN_SERVICE="Claude Code-credentials"

is_macos() {
    [[ "$(uname)" == "Darwin" ]]
}

# Read the password from a Keychain entry by service name.
keychain_read_password() {
    local service="$1"
    security find-generic-password -w -s "$service" 2>/dev/null || true
}

# Detect the "account" string stored in a Keychain entry.
# `security find-generic-password` prints lines like:   "acct"<blob>="user@example.com"
# The value we want is the second-to-last quoted field on that line.
keychain_detect_account() {
    local service="$1"
    security find-generic-password -s "$service" 2>/dev/null \
        | awk -F'"' '/"acct"<blob>=/{print $(NF-1); exit}'
}

# Whether the canonical Claude Code Keychain entry exists.
# Uses metadata lookup only (no -w), so it does not prompt for ACL access.
keychain_canonical_exists() {
    is_macos || return 1
    security find-generic-password -s "$KEYCHAIN_SERVICE" >/dev/null 2>&1
}

# Stash the current canonical token under a per-profile slot.
# Returns 0 if stashed, 1 if nothing to stash.
keychain_stash_canonical_as() {
    local profile="$1"
    is_macos || return 1

    local token
    token=$(keychain_read_password "$KEYCHAIN_SERVICE")
    [[ -z "$token" ]] && return 1

    local account
    account=$(keychain_detect_account "$KEYCHAIN_SERVICE")
    [[ -z "$account" ]] && account="claudewho-${profile}"

    security add-generic-password -U \
        -s "${KEYCHAIN_SERVICE}-${profile}" \
        -a "$account" \
        -w "$token" 2>/dev/null
}

# Restore a per-profile stash into the canonical slot.
# Returns 0 on success, 1 if no stash exists for that profile.
keychain_restore_to_canonical() {
    local profile="$1"
    is_macos || return 1

    local token
    token=$(keychain_read_password "${KEYCHAIN_SERVICE}-${profile}")
    [[ -z "$token" ]] && return 1

    local account
    account=$(keychain_detect_account "${KEYCHAIN_SERVICE}-${profile}")
    [[ -z "$account" ]] && account="claudewho-${profile}"

    security add-generic-password -U \
        -s "$KEYCHAIN_SERVICE" \
        -a "$account" \
        -w "$token" 2>/dev/null
}

# Delete the canonical Keychain entry (forces re-login on next claude run).
keychain_clear_canonical() {
    is_macos || return 0
    security delete-generic-password -s "$KEYCHAIN_SERVICE" 2>/dev/null || true
}

# Delete a per-profile stash.
keychain_delete_profile() {
    local profile="$1"
    is_macos || return 0
    security delete-generic-password -s "${KEYCHAIN_SERVICE}-${profile}" 2>/dev/null || true
}

# Check whether a per-profile stash exists.
keychain_profile_exists() {
    local profile="$1"
    is_macos || return 1
    security find-generic-password -s "${KEYCHAIN_SERVICE}-${profile}" >/dev/null 2>&1
}

# --- Suffix bindings (profile -> 8-hex suffix of a CLI keychain entry) ---
# Persisted in $KEYCHAIN_MAP_FILE, one line per profile: profile=suffix
# These let `claudewho use <name>` copy the right CLI-owned credential
# (Claude Code-credentials-<suffix>) into the suffix-less canonical slot
# that the Desktop/IDE Claude Code reads, so the user doesn't have to log
# in twice (once for CLI, once for IDE).

keychain_get_binding() {
    local profile="$1"
    [[ -f "$KEYCHAIN_MAP_FILE" ]] || return 1
    local suffix
    suffix=$(grep -E "^${profile}=" "$KEYCHAIN_MAP_FILE" 2>/dev/null | cut -d= -f2- | head -n1)
    [[ -z "$suffix" ]] && return 1
    printf '%s' "$suffix"
}

keychain_set_binding() {
    local profile="$1"
    local suffix="$2"
    touch "$KEYCHAIN_MAP_FILE"
    local tmp
    tmp=$(mktemp)
    grep -vE "^${profile}=" "$KEYCHAIN_MAP_FILE" 2>/dev/null > "$tmp" || true
    echo "${profile}=${suffix}" >> "$tmp"
    mv "$tmp" "$KEYCHAIN_MAP_FILE"
}

keychain_remove_binding() {
    local profile="$1"
    [[ -f "$KEYCHAIN_MAP_FILE" ]] || return 0
    local tmp
    tmp=$(mktemp)
    grep -vE "^${profile}=" "$KEYCHAIN_MAP_FILE" > "$tmp" || true
    mv "$tmp" "$KEYCHAIN_MAP_FILE"
}

# Copy the bound suffixed entry into the canonical (IDE) slot.
# Returns 0 on success, 1 if no binding or no source entry.
keychain_apply_binding() {
    local profile="$1"
    is_macos || return 1

    local suffix
    suffix=$(keychain_get_binding "$profile") || return 1

    local src="Claude Code-credentials-${suffix}"
    local token
    token=$(keychain_read_password "$src")
    [[ -z "$token" ]] && return 1

    local account
    account=$(keychain_detect_account "$src")
    [[ -z "$account" ]] && account="$USER"

    security add-generic-password -U \
        -s "$KEYCHAIN_SERVICE" \
        -a "$account" \
        -w "$token" 2>/dev/null
}

# Swap canonical (IDE/Desktop) credentials when switching from prev to next.
# Always stashes the previous canonical first, then prefers `next`'s suffix
# binding if set, else falls back to restoring `next`'s legacy stash.
keychain_swap() {
    local prev="$1"
    local next="$2"

    is_macos || return 0
    [[ "$prev" == "$next" ]] && return 0

    # Preserve whatever's in the canonical slot under prev's stash.
    # Harmless if canonical is empty or prev is empty.
    if [[ -n "$prev" ]]; then
        if keychain_stash_canonical_as "$prev"; then
            echo -e "  ${DIM}Stashed current credentials as '${prev}'.${NC}"
        fi
    fi

    if keychain_apply_binding "$next"; then
        echo -e "  ${DIM}Copied '${next}' CLI credentials to IDE slot.${NC}"
        return 0
    fi

    if keychain_restore_to_canonical "$next"; then
        echo -e "  ${DIM}Restored saved credentials for '${next}'.${NC}"
    else
        keychain_clear_canonical
        echo -e "  ${YELLOW}No saved credentials or binding for '${next}'.${NC}"
        echo -e "  ${DIM}Hint: ${BOLD}claudewho keychain status${NC}${DIM} lists suffixed entries; bind with ${BOLD}claudewho keychain bind ${next} <suffix>${NC}${DIM}.${NC}"
    fi
}

# Extract a JSON string value via jq, falling back to a tolerant regex
# if jq is not installed. Returns the value on stdout, or empty.
# Usage: json_get_string <file> <jq-path> <flat-key-name>
# Example: json_get_string "$cj" '.oauthAccount.emailAddress' emailAddress
json_get_string() {
    local file="$1"
    local jq_path="$2"
    local flat_key="$3"
    [[ -f "$file" ]] || return 0
    if command -v jq >/dev/null 2>&1; then
        jq -r "${jq_path} // empty" "$file" 2>/dev/null
    else
        # Look for "key":"value" in the file. Permissive whitespace.
        grep -oE "\"${flat_key}\"[[:space:]]*:[[:space:]]*\"[^\"]+\"" "$file" 2>/dev/null \
            | head -n1 \
            | sed -E "s/.*\"${flat_key}\"[[:space:]]*:[[:space:]]*\"([^\"]+)\".*/\1/"
    fi
}

# Whether a profile has been logged in at least once.
# Source of truth: $CLAUDE_CONFIG_DIR/.claude.json's oauthAccount.accountUuid.
# If present, the profile knows its identity and the CLI will use the
# matching suffixed Keychain entry on macOS (or .credentials.json elsewhere).
account_is_authenticated() {
    local name="$1"
    local dir="${CONFIG_DIR_PREFIX}${name}"
    local cj="$dir/.claude.json"

    [[ -f "$cj" ]] || return 1

    if is_macos; then
        local uuid
        uuid=$(json_get_string "$cj" '.oauthAccount.accountUuid' accountUuid)
        [[ -n "$uuid" ]]
    else
        [[ -f "$dir/.credentials.json" ]]
    fi
}

# Read the profile's email from .claude.json oauthAccount, or empty string.
account_email() {
    local name="$1"
    json_get_string "${CONFIG_DIR_PREFIX}${name}/.claude.json" \
        '.oauthAccount.emailAddress' emailAddress
}

# Print Keychain state across canonical + per-profile slots.
keychain_status() {
    if ! is_macos; then
        echo "Keychain integration only applies on macOS."
        echo "On this OS, credentials live in \$CLAUDE_CONFIG_DIR/.credentials.json."
        return 0
    fi

    echo -e "${BOLD}Keychain status:${NC}"
    echo ""

    if keychain_canonical_exists; then
        local canon_acct
        canon_acct=$(keychain_detect_account "$KEYCHAIN_SERVICE")
        echo -e "  ${BLUE}canonical${NC}                 ${GREEN}present${NC}  account=${canon_acct:-<unknown>}"
    else
        echo -e "  ${BLUE}canonical${NC}                 ${YELLOW}empty${NC}"
    fi

    local accounts current
    accounts=$(get_accounts)
    current=$(get_current_account)

    if [[ -n "$accounts" ]]; then
        echo ""
        echo -e "  ${BOLD}Per-profile stashes:${NC}"
        while IFS= read -r name; do
            local marker=""
            [[ "$name" == "$current" ]] && marker=" ${GREEN}(current)${NC}"
            if keychain_profile_exists "$name"; then
                local acct
                acct=$(keychain_detect_account "${KEYCHAIN_SERVICE}-${name}")
                printf "    ${BLUE}%-20s${NC}   ${GREEN}present${NC}  account=%s%b\n" \
                    "$name" "${acct:-<unknown>}" "$marker"
            else
                printf "    ${BLUE}%-20s${NC}   ${DIM}empty${NC}%b\n" "$name" "$marker"
            fi
        done <<< "$accounts"
    fi

    # CLI-owned suffixed entries (Claude Code-credentials-<8hex>)
    echo ""
    echo -e "  ${BOLD}CLI suffixed entries (one per Anthropic account):${NC}"
    local suffixed
    suffixed=$(security dump-keychain ~/Library/Keychains/login.keychain-db 2>/dev/null \
        | grep -oE '"svce"<blob>="Claude Code-credentials-[0-9a-f]{8,}"' \
        | sed -E 's/.*"(Claude Code-credentials-[0-9a-f]+)".*/\1/' \
        | sort -u)
    if [[ -z "$suffixed" ]]; then
        echo "    (none)"
    else
        while IFS= read -r svc; do
            local sfx="${svc##Claude Code-credentials-}"
            local bound_to=""
            if [[ -f "$KEYCHAIN_MAP_FILE" ]]; then
                bound_to=$(grep -E "=${sfx}$" "$KEYCHAIN_MAP_FILE" | cut -d= -f1 | paste -sd, -)
            fi
            if [[ -n "$bound_to" ]]; then
                printf "    ${BLUE}%-20s${NC}   bound to: %s\n" "$sfx" "$bound_to"
            else
                printf "    ${BLUE}%-20s${NC}   ${DIM}unbound${NC}\n" "$sfx"
            fi
        done <<< "$suffixed"
    fi

    # Show all bindings (even if their suffixed entry is missing)
    if [[ -f "$KEYCHAIN_MAP_FILE" && -s "$KEYCHAIN_MAP_FILE" ]]; then
        echo ""
        echo -e "  ${BOLD}Profile suffix bindings:${NC}"
        while IFS='=' read -r profile suffix; do
            [[ -z "$profile" ]] && continue
            local marker=""
            [[ "$profile" == "$current" ]] && marker=" ${GREEN}(current)${NC}"
            local svc="Claude Code-credentials-${suffix}"
            local presence
            if security find-generic-password -s "$svc" >/dev/null 2>&1; then
                presence="${GREEN}present${NC}"
            else
                presence="${RED}missing${NC}"
            fi
            printf "    ${BLUE}%-20s${NC} → ${suffix}   (%b)%b\n" "$profile" "$presence" "$marker"
        done < "$KEYCHAIN_MAP_FILE"
    fi

    echo ""
    echo -e "${DIM}IDE/Desktop service: '${KEYCHAIN_SERVICE}'${NC}"
    echo -e "${DIM}CLI per-account service: '${KEYCHAIN_SERVICE}-<8hex>'${NC}"
    echo -e "${DIM}claudewho per-profile stash: '${KEYCHAIN_SERVICE}-<name>'${NC}"
    echo -e "${DIM}Suffix bindings file: ${KEYCHAIN_MAP_FILE}${NC}"
}

# Bind a profile to a CLI suffixed Keychain entry.
keychain_bind() {
    local profile="${1:-}"
    local suffix="${2:-}"

    if [[ -z "$profile" || -z "$suffix" ]]; then
        echo -e "${RED}Error:${NC} Profile and suffix required"
        echo "Usage: claudewho keychain bind <profile> <suffix>"
        echo ""
        echo "Hint: 'claudewho keychain status' lists available suffixes."
        exit 1
    fi

    if ! account_exists "$profile"; then
        echo -e "${RED}Error:${NC} Profile '$profile' not found"
        echo "Run 'claudewho list' to see available profiles."
        exit 1
    fi

    if is_macos; then
        if ! security find-generic-password -s "Claude Code-credentials-${suffix}" >/dev/null 2>&1; then
            echo -e "${YELLOW}Warning:${NC} no Keychain entry 'Claude Code-credentials-${suffix}' found."
            echo "The binding will be saved, but 'claudewho use ${profile}' will skip the copy"
            echo "until that entry exists (it gets created when you log in via the CLI)."
        fi
    fi

    keychain_set_binding "$profile" "$suffix"
    echo -e "${GREEN}Bound${NC} ${BLUE}${profile}${NC} → ${suffix}"
    echo "Next 'claudewho use ${profile}' will copy this entry into the IDE slot."
}

# Remove a profile's suffix binding.
keychain_unbind() {
    local profile="${1:-}"
    if [[ -z "$profile" ]]; then
        echo -e "${RED}Error:${NC} Profile required"
        echo "Usage: claudewho keychain unbind <profile>"
        exit 1
    fi
    keychain_remove_binding "$profile"
    echo -e "${GREEN}Unbound${NC} ${BLUE}${profile}${NC}"
}
# ---------------------------------------------------------------------------

# Create/update the main claude wrapper
create_claude_wrapper() {
    local wrapper_path="${WRAPPER_DIR}/claude"

    mkdir -p "$WRAPPER_DIR"

    cat > "$wrapper_path" << 'WRAPPER_EOF'
#!/bin/bash
# Claude wrapper - managed by claudewho
# This wrapper allows switching accounts with: claudewho use <name>

CURRENT_ACCOUNT_FILE="$HOME/.claudewho-current-account"
CONFIG_DIR_PREFIX="$HOME/.claudewho-"
WRAPPER_DIR="$HOME/.local/bin"

# Find the real claude binary (skip our wrapper)
find_real_claude() {
    # First check known Claude installation locations
    local versions_dir="$HOME/.local/share/claude/versions"
    if [[ -d "$versions_dir" ]]; then
        # Find the largest file (real binary, not wrapper scripts)
        local real_binary
        real_binary=$(find "$versions_dir" -type f -size +1M | sort -V | tail -1)
        if [[ -n "$real_binary" && -x "$real_binary" ]]; then
            echo "$real_binary"
            return 0
        fi
    fi

    # Fallback: search PATH for claude binary (skip wrapper directory)
    local IFS=':'
    for dir in $PATH; do
        [[ "$dir" == "$WRAPPER_DIR" ]] && continue
        if [[ -x "$dir/claude" ]]; then
            echo "$dir/claude"
            return 0
        fi
    done

    # No real claude found - error instead of infinite loop
    echo "Error: Could not find real Claude binary." >&2
    echo "Expected locations:" >&2
    echo "  - ~/.local/share/claude/versions/" >&2
    echo "  - /usr/local/bin/claude" >&2
    echo "  - /opt/homebrew/bin/claude" >&2
    exit 1
}

# Only follow the current-account file if a parent hasn't already set
# CLAUDE_CONFIG_DIR (e.g. via `claudewho-<name>`). Otherwise we'd stomp
# the explicit per-account choice.
if [[ -z "${CLAUDE_CONFIG_DIR:-}" && -f "$CURRENT_ACCOUNT_FILE" ]]; then
    account=$(cat "$CURRENT_ACCOUNT_FILE" 2>/dev/null)
    if [[ -n "$account" ]]; then
        export CLAUDE_CONFIG_DIR="${CONFIG_DIR_PREFIX}${account}"
    fi
fi

# Find and exec real claude
real_claude=$(find_real_claude)
exec "$real_claude" "$@"
WRAPPER_EOF

    chmod +x "$wrapper_path"
}

# Create a generic wrapper for an arbitrary command that shadows the real
# binary on PATH and injects CLAUDE_CONFIG_DIR based on the current account.
create_command_wrapper() {
    local cmd="$1"
    local wrapper_path="${WRAPPER_DIR}/${cmd}"

    mkdir -p "$WRAPPER_DIR"

    cat > "$wrapper_path" << WRAPPER_EOF
#!/bin/bash
# ${cmd} wrapper - managed by claudewho
# Shadows the real ${cmd} binary on PATH and exports CLAUDE_CONFIG_DIR
# based on the account selected via 'claudewho use <name>'.

CURRENT_ACCOUNT_FILE="\$HOME/.claudewho-current-account"
CONFIG_DIR_PREFIX="\$HOME/.claudewho-"
WRAPPER_DIR="\$HOME/.local/bin"

# Find the real ${cmd} binary on PATH, skipping our wrapper directory
# to avoid recursing into ourselves.
find_real_cmd() {
    local IFS=':'
    for dir in \$PATH; do
        [[ "\$dir" == "\$WRAPPER_DIR" ]] && continue
        if [[ -x "\$dir/${cmd}" ]]; then
            echo "\$dir/${cmd}"
            return 0
        fi
    done
    echo "Error: Could not find real ${cmd} binary on PATH (excluding \$WRAPPER_DIR)." >&2
    exit 1
}

if [[ -f "\$CURRENT_ACCOUNT_FILE" ]]; then
    account=\$(cat "\$CURRENT_ACCOUNT_FILE" 2>/dev/null)
    if [[ -n "\$account" ]]; then
        export CLAUDE_CONFIG_DIR="\${CONFIG_DIR_PREFIX}\${account}"
    fi
fi

real_cmd=\$(find_real_cmd)
exec "\$real_cmd" "\$@"
WRAPPER_EOF

    chmod +x "$wrapper_path"
}

# Wrap an arbitrary command so it picks up the current claudewho account.
wrap_command() {
    local cmd="${1:-}"

    if [[ -z "$cmd" ]]; then
        echo -e "${RED}Error:${NC} Command name required"
        echo "Usage: claudewho wrap <command>"
        echo ""
        echo "Example:"
        echo "    claudewho wrap recall"
        exit 1
    fi

    # Validate command name (same rules as account names, plus underscores/dots)
    if [[ ! "$cmd" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
        echo -e "${RED}Error:${NC} Invalid command name '$cmd'"
        exit 1
    fi

    # Verify a real binary exists somewhere on PATH outside WRAPPER_DIR.
    local found=""
    local IFS=':'
    for dir in $PATH; do
        [[ "$dir" == "$WRAPPER_DIR" ]] && continue
        if [[ -x "$dir/$cmd" ]]; then
            found="$dir/$cmd"
            break
        fi
    done
    unset IFS

    if [[ -z "$found" ]]; then
        echo -e "${YELLOW}Warning:${NC} No real '$cmd' binary found on PATH (outside $WRAPPER_DIR)."
        echo "The wrapper will be created, but will fail at runtime until '$cmd' is installed."
        read -rp "Continue? [y/N] " confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            echo "Aborted."
            exit 0
        fi
    fi

    create_command_wrapper "$cmd"

    echo -e "${GREEN}Created${NC} ${WRAPPER_DIR}/${cmd}"
    if [[ -n "$found" ]]; then
        echo -e "  Shadows: ${DIM}${found}${NC}"
    fi
    echo ""
    echo "Make sure ${WRAPPER_DIR} comes before $(dirname "${found:-/usr/local/bin}") in your PATH."
    echo "Then '$cmd' will automatically use the account selected by 'claudewho use <name>'."

    if ! check_path; then
        echo ""
        echo -e "${YELLOW}Note:${NC} ~/.local/bin is not in your PATH. Add it with:"
        echo "    echo 'export PATH=\"\$HOME/.local/bin:\$PATH\"' >> ~/.zshrc && source ~/.zshrc"
    fi
}

# Show banner
show_banner() {
    echo ""
    echo -e "${ORANGE}   ____ _        _   _   _ ____  _______        ___   _  ___  ${NC}"
    echo -e "${ORANGE}  / ___| |      / \\ | | | |  _ \\| ____\\ \\      / / | | |/ _ \\ ${NC}"
    echo -e "${ORANGE} | |   | |     / _ \\| | | | | | |  _|  \\ \\ /\\ / /| |_| | | | |${NC}"
    echo -e "${ORANGE} | |___| |___ / ___ \\ |_| | |_| | |___  \\ V  V / |  _  | |_| |${NC}"
    echo -e "${ORANGE}  \\____|_____/_/   \\_\\___/|____/|_____|  \\_/\\_/  |_| |_|\\___/ ${NC}"
    echo ""
}

# Show usage
usage() {
    show_banner
    echo -e "${BOLD}USAGE:${NC}"
    echo "    claudewho <command> [arguments]"
    echo ""
    echo -e "${BOLD}COMMANDS:${NC}"
    echo "    list                List all configured accounts"
    echo "    add <name>          Create a new account configuration"
    echo "    remove <name>       Remove an account (with confirmation)"
    echo "    use <name>          Switch to an account"
    echo "    export              Print the account list as JSON (no credentials)"
    echo "    import [FILE|-]     Register accounts from exported JSON (default: stdin)"
    echo "    wrap <command>      Create a wrapper that runs <command> under the current account"
    echo "    ide-setup           Configure IDE integration (VSCode)"
    echo "    shell-init          Print shell aliases (alternative to wrapper scripts)"
    echo "    keychain status     Show Keychain state (macOS)"
    echo "    keychain bind <p> <suffix>  Bind a profile to a CLI Keychain entry (macOS)"
    echo "    keychain unbind <p>         Remove a profile's suffix binding (macOS)"
    echo "    version             Show version information"
    echo "    help                Show this help message"
    echo ""
    echo -e "${BOLD}QUICK START:${NC}"
    echo "    claudewho add work       # Creates 'work' account"
    echo "    claudewho-work           # Launch Claude with 'work' account"
    echo "    claudewho use work       # Switch default account"
    echo "    claude                   # Uses current account"
    echo ""
    echo -e "${BOLD}EXAMPLES:${NC}"
    echo "    claudewho add work"
    echo "    claudewho add personal"
    echo "    claudewho list"
    echo "    claudewho-work"
    echo "    claudewho-personal"
    echo ""
    echo -e "${BOLD}VERSION:${NC}"
    echo "    $VERSION"
}

# List all accounts
list_accounts() {
    local accounts
    accounts=$(get_accounts)
    local current
    current=$(get_current_account)

    if [[ -z "$accounts" ]]; then
        echo -e "${YELLOW}No accounts configured.${NC}"
        echo ""
        echo "Create one with:"
        echo "    claudewho add <name>"
        return 0
    fi

    echo -e "${BOLD}Configured Claude accounts:${NC}"
    echo ""

    while IFS= read -r name; do
        local dir="${CONFIG_DIR_PREFIX}${name}"
        local status
        local marker=""

        # Mark current account
        if [[ "$name" == "$current" ]]; then
            marker="${GREEN}*${NC} "
        else
            marker="  "
        fi

        local identity=""
        if [[ -d "$dir" ]]; then
            if account_is_authenticated "$name"; then
                status="${GREEN}authenticated${NC}"
                local email
                email=$(account_email "$name")
                [[ -n "$email" ]] && identity=" ${DIM}${email}${NC}"
            else
                status="${YELLOW}not logged in${NC}"
            fi
        else
            status="${RED}directory missing${NC}"
        fi

        printf "${marker}${BLUE}%-20s${NC} %-30s (%b)%b\n" "$name" "$dir" "$status" "$identity"
    done <<< "$accounts"

    echo ""
    if [[ -n "$current" ]]; then
        echo -e "${GREEN}*${NC} = current account"
        echo ""
    fi
    echo -e "Switch with ${BOLD}claudewho use <name>${NC}"
}

# Add a new account
add_account() {
    local name="${1:-}"

    if [[ -z "$name" ]]; then
        echo -e "${RED}Error:${NC} Account name required"
        echo "Usage: claudewho add <name>"
        exit 1
    fi

    validate_name "$name"

    if account_exists "$name"; then
        echo -e "${RED}Error:${NC} Account '$name' already exists"
        exit 1
    fi

    local dir="${CONFIG_DIR_PREFIX}${name}"

    if [[ -d "$dir" ]]; then
        echo -e "${YELLOW}Warning:${NC} Directory $dir already exists"
        read -rp "Register this existing directory as account '$name'? [y/N] " confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            echo "Aborted."
            exit 0
        fi
    else
        mkdir -p "$dir"
        echo -e "${GREEN}Created${NC} $dir"
    fi

    # Register the account
    touch_config
    echo "$name" >> "$CONFIG_FILE"

    # Create wrapper scripts
    create_wrapper "$name"
    create_ide_account_wrapper "$name"
    echo -e "${GREEN}Created${NC} ${WRAPPER_DIR}/claudewho-${name}"

    echo -e "${GREEN}Account '$name' added successfully!${NC}"
    echo ""

    # Check if ~/.local/bin is in PATH
    if ! check_path; then
        echo -e "${YELLOW}Note:${NC} Add ~/.local/bin to your PATH (one-time setup):"
        echo "    echo 'export PATH=\"\$HOME/.local/bin:\$PATH\"' >> ~/.zshrc && source ~/.zshrc"
        echo ""
    fi

    echo "Launch Claude with this account:"
    echo "    claudewho-${name}"
}

# Require jq for export/import
require_jq() {
    if ! command -v jq >/dev/null 2>&1; then
        echo -e "${RED}Error:${NC} jq is required for export/import (brew install jq)"
        exit 1
    fi
}

# Export the account list as JSON (names and current account only)
export_accounts() {
    require_jq
    local current
    current=$(get_current_account)
    get_accounts | jq -R -s -c --arg current "$current" '
        {version: 1,
         accounts: (split("\n") | map(select(length > 0))),
         current: (if $current == "" then null else $current end)}'
}

# Import accounts from JSON produced by 'claudewho export'
import_accounts() {
    require_jq
    local src="${1:--}"
    local json

    if [[ "$src" == "-" ]]; then
        json=$(cat)
    elif [[ -f "$src" ]]; then
        json=$(cat "$src")
    else
        echo -e "${RED}Error:${NC} File not found: $src"
        exit 1
    fi

    if ! printf '%s' "$json" | jq -e '(.accounts | type) == "array" and all(.accounts[]; type == "string")' >/dev/null 2>&1; then
        echo -e "${RED}Error:${NC} Invalid JSON: expected {\"accounts\": [\"name\", ...]}"
        exit 1
    fi

    local names=()
    local name
    while IFS= read -r name; do
        names+=("$name")
    done < <(printf '%s' "$json" | jq -r '.accounts[]')

    # Validate every name before changing anything
    for name in ${names[@]+"${names[@]}"}; do
        validate_name "$name"
    done

    local added=0
    for name in ${names[@]+"${names[@]}"}; do
        if account_exists "$name"; then
            echo -e "${DIM}exists${NC} $name"
            continue
        fi
        mkdir -p "${CONFIG_DIR_PREFIX}${name}"
        touch_config
        echo "$name" >> "$CONFIG_FILE"
        create_wrapper "$name"
        create_ide_account_wrapper "$name"
        echo -e "${GREEN}added${NC} $name"
        added=$((added + 1))
    done

    if [[ $added -gt 0 ]]; then
        echo ""
        echo "Log in to each new account: claudewho use <name>"
    fi
}

# Remove an account
remove_account() {
    local name="${1:-}"

    if [[ -z "$name" ]]; then
        echo -e "${RED}Error:${NC} Account name required"
        echo "Usage: claudewho remove <name>"
        exit 1
    fi

    if ! account_exists "$name"; then
        echo -e "${RED}Error:${NC} Account '$name' not found"
        echo "Run 'claudewho list' to see available accounts."
        exit 1
    fi

    local dir="${CONFIG_DIR_PREFIX}${name}"

    echo -e "${YELLOW}Warning:${NC} This will remove account '$name'"
    if [[ -d "$dir" ]]; then
        echo "  Directory: $dir (will be deleted)"
    fi
    local wrapper_path="${WRAPPER_DIR}/claudewho-${name}"
    if [[ -f "$wrapper_path" ]]; then
        echo "  Command: $wrapper_path (will be deleted)"
    fi
    echo ""
    read -rp "Are you sure? [y/N] " confirm

    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        echo "Aborted."
        exit 0
    fi

    # Remove directory if it exists
    if [[ -d "$dir" ]]; then
        rm -rf "$dir"
        echo -e "${GREEN}Removed${NC} $dir"
    fi

    # Remove wrapper scripts
    remove_wrapper "$name"
    remove_ide_account_wrapper "$name"
    echo -e "${GREEN}Removed${NC} ${WRAPPER_DIR}/claudewho-${name}"

    # Clean up Keychain stash if any
    keychain_delete_profile "$name"

    # Remove from config (create temp file without the account)
    local tmp_file
    tmp_file=$(mktemp)
    grep -vx "$name" "$CONFIG_FILE" > "$tmp_file" || true
    mv "$tmp_file" "$CONFIG_FILE"

    echo -e "${GREEN}Account '$name' removed successfully!${NC}"
}

# Switch to an account
use_account() {
    local name="${1:-}"

    if [[ -z "$name" ]]; then
        echo -e "${RED}Error:${NC} Account name required"
        echo "Usage: claudewho use <name>"
        exit 1
    fi

    if ! account_exists "$name"; then
        echo -e "${RED}Error:${NC} Account '$name' not found"
        echo "Run 'claudewho list' to see available accounts."
        exit 1
    fi

    local dir="${CONFIG_DIR_PREFIX}${name}"

    if [[ ! -d "$dir" ]]; then
        echo -e "${YELLOW}Warning:${NC} Creating missing directory $dir"
        mkdir -p "$dir"
    fi

    # Ensure wrappers exist
    create_claude_wrapper
    create_ide_wrapper

    local prev
    prev=$(get_current_account)

    # Swap Keychain credentials (macOS only; no-op elsewhere)
    keychain_swap "$prev" "$name"

    # Save current account
    echo "$name" > "$CURRENT_ACCOUNT_FILE"

    echo -e "${GREEN}Switched to${NC} ${BLUE}$name${NC}"
    echo -e "Now using: $dir"
}

# IDE integration setup
ide_setup() {
    local target_account=""

    # Parse flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --account|-a)
                target_account="${2:-}"
                if [[ -z "$target_account" ]]; then
                    echo -e "${RED}Error:${NC} --account requires a name"
                    exit 1
                fi
                shift 2
                ;;
            *)
                echo -e "${RED}Error:${NC} Unknown option '$1'"
                echo "Usage: claudewho ide-setup [--account <name>]"
                exit 1
                ;;
        esac
    done

    local accounts
    accounts=$(get_accounts)

    if [[ -z "$accounts" ]]; then
        echo -e "${YELLOW}No accounts configured.${NC}"
        echo "Create one first with: claudewho add <name>"
        return 0
    fi

    # Validate target account if specified
    if [[ -n "$target_account" ]]; then
        if ! account_exists "$target_account"; then
            echo -e "${RED}Error:${NC} Account '$target_account' not found"
            echo "Run 'claudewho list' to see available accounts."
            exit 1
        fi
    fi

    # Ensure all wrappers exist
    create_ide_wrapper
    while IFS= read -r name; do
        create_ide_account_wrapper "$name"
    done <<< "$accounts"

    local current
    current=$(get_current_account)

    if [[ -n "$target_account" ]]; then
        # Show config for a specific account
        echo -e "${BOLD}IDE setup for account '${BLUE}${target_account}${NC}${BOLD}':${NC}"
        echo ""
        echo "  Add to your VSCode settings.json:"
        echo ""
        echo -e "    ${CYAN}\"claude-code.claudeProcessWrapper\": \"${WRAPPER_DIR}/claudewho-ide-${target_account}\"${NC}"
        echo ""
        echo "  For workspace-specific config, add to .vscode/settings.json instead."
    else
        # Show full instructions
        echo -e "${BOLD}IDE Integration Setup${NC}"
        echo ""
        echo -e "${BOLD}Option 1:${NC} Follow current account ${DIM}(all IDE windows share one account)${NC}"
        echo ""
        echo -e "  Add to your VSCode settings.json (${BOLD}Cmd+Shift+P${NC} > \"Open Settings (JSON)\"):"
        echo ""
        echo -e "    ${CYAN}\"claude-code.claudeProcessWrapper\": \"${WRAPPER_DIR}/claudewho-ide\"${NC}"
        echo ""
        echo "  Then switch accounts with: claudewho use <name>"
        if [[ -n "$current" ]]; then
            echo -e "  Current account: ${GREEN}${current}${NC}"
        fi
        echo ""
        echo -e "${BOLD}Option 2:${NC} Fixed account per workspace ${DIM}(supports parallel accounts)${NC}"
        echo ""
        echo "  Add to your workspace .vscode/settings.json:"
        echo ""
        echo -e "    ${CYAN}\"claude-code.claudeProcessWrapper\": \"${WRAPPER_DIR}/claudewho-ide-<name>\"${NC}"
        echo ""
        echo "  Available per-account wrappers:"
        while IFS= read -r name; do
            local marker=""
            if [[ "$name" == "$current" ]]; then
                marker=" ${GREEN}(current)${NC}"
            fi
            echo -e "    ${BLUE}${WRAPPER_DIR}/claudewho-ide-${name}${NC}${marker}"
        done <<< "$accounts"
    fi
    echo ""
}

# Print shell initialization (aliases)
shell_init() {
    local accounts
    accounts=$(get_accounts)

    echo "# Claude Account Aliases (managed by claudewho)"
    echo "# Generated by: claudewho shell-init"
    echo ""

    if [[ -z "$accounts" ]]; then
        echo "# No accounts configured yet."
        echo "# Run 'claudewho add <name>' to create one."
        return 0
    fi

    while IFS= read -r name; do
        local dir="${CONFIG_DIR_PREFIX}${name}"
        echo "alias $name=\"CLAUDE_CONFIG_DIR='$dir' claude\""
    done <<< "$accounts"
}

# Main command router
main() {
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        list|ls)
            list_accounts
            ;;
        add|create|new)
            add_account "$@"
            ;;
        remove|delete|rm)
            remove_account "$@"
            ;;
        use|run|launch)
            use_account "$@"
            ;;
        export)
            export_accounts
            ;;
        import)
            import_accounts "$@"
            ;;
        wrap)
            wrap_command "$@"
            ;;
        ide-setup|ide|vscode-setup)
            ide_setup "$@"
            ;;
        shell-init|init|aliases)
            shell_init
            ;;
        keychain)
            local sub="${1:-status}"
            shift || true
            case "$sub" in
                status|"")
                    keychain_status
                    ;;
                bind)
                    keychain_bind "$@"
                    ;;
                unbind)
                    keychain_unbind "$@"
                    ;;
                *)
                    echo -e "${RED}Error:${NC} Unknown keychain subcommand '$sub'"
                    echo "Usage: claudewho keychain {status|bind <p> <suffix>|unbind <p>}"
                    exit 1
                    ;;
            esac
            ;;
        version|-v|--version)
            echo "claudewho $VERSION"
            ;;
        help|-h|--help)
            usage
            ;;
        *)
            echo -e "${RED}Error:${NC} Unknown command '$cmd'"
            echo "Run 'claudewho help' for usage information."
            exit 1
            ;;
    esac
}

main "$@"
